# ---------------------------------------------------------------------------
# Laguisoft Lead Finder - variables d'environnement
# Copier ce fichier en ".env" et adapter les valeurs pour l'environnement local.
# Ne jamais committer le fichier ".env" reel (voir .gitignore).
# ---------------------------------------------------------------------------

# --- Application ---
NODE_ENV=development
APP_PORT=3000
APP_NAME=laguisoft-lead-finder
LOG_LEVEL=info
# Cle partagee entre le dashboard, l'API et les workflows n8n (en-tete x-api-key).
# Generer une valeur forte, ex: openssl rand -hex 32
DASHBOARD_API_KEY=change_me_dashboard_api_key

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=llf_user
POSTGRES_PASSWORD=llf_password
POSTGRES_DB=laguisoft_lead_finder
DATABASE_URL=postgresql://llf_user:llf_password@postgres:5432/laguisoft_lead_finder

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=llf_redis_password
REDIS_URL=redis://:llf_redis_password@redis:6379

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_ENCRYPTION_KEY=change_me_encryption_key
N8N_API_KEY=

# --- Claude (Anthropic) - analyse des prospects et generation des messages ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- OpenAI (optionnel, non utilise par defaut) ---
OPENAI_API_KEY=

# --- Moteurs de recherche : chaque moteur est desactive par defaut tant que
#     sa cle n'est pas fournie. Activer uniquement ceux dont vous avez les
#     acces (voir docs/apis-guide.md pour la procedure d'obtention). ---
GOOGLE_CSE_ENABLED=false
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=

BING_SEARCH_ENABLED=false
BING_SEARCH_API_KEY=

BRAVE_SEARCH_ENABLED=false
BRAVE_SEARCH_API_KEY=

TAVILY_ENABLED=false
TAVILY_API_KEY=

# API "Instant Answer" publique, sans cle (couverture limitee, voir
# src/services/search/duckduckgoSearch.ts).
DUCKDUCKGO_ENABLED=false

# --- Recherche et extraction : limites de debit et respect de robots.txt ---
SEARCH_MAX_REQUESTS_PER_MINUTE=20
EXTRACTION_MAX_REQUESTS_PER_MINUTE=15
EXTRACTION_RESPECT_ROBOTS_TXT=true
EXTRACTION_USER_AGENT="LaguisoftLeadFinderBot/1.0 (+https://laguisoft.com; prospection B2B)"

# --- Envoi d'email (SMTP) ---
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Laguisoft Technologie <contact@laguisoft.com>"

# --- WhatsApp Business Cloud API (Meta) ---
# Envoi uniquement apres consentement explicite du prospect, confirme a
# chaque envoi depuis le dashboard (voir docs/apis-guide.md).
WHATSAPP_ENABLED=false
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_REQUIRE_OPT_IN=true

# --- Pipeline de prospection ---
PIPELINE_MAX_QUERIES_PER_RUN=40
PIPELINE_MAX_RESULTS_PER_QUERY=10
# Si "true" (recommande), aucun message ne peut etre envoye avant validation
# manuelle du prospect dans le dashboard.
PIPELINE_REQUIRE_HUMAN_VALIDATION=true
